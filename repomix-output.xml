        opacity 700ms var(--pub-ease),
        transform 700ms var(--pub-ease);
}
.public-shell [data-reveal].is-revealed .reveal-word {
    opacity: 1;
    transform: translateY(0);
}

.public-shell .btn-cta {
    display: inline-flex;
    align-items: stretch;
    text-decoration: none;
}
.public-shell .btn-cta-label {
