        flex-direction: column;
    }

    .event-toolbar-tools .directory-filter,
    .graduate-toolbar-tools .directory-filter {
        width: 100%;
    }

    .event-grid {
        grid-template-columns: 1fr;
    }
}

.graduate-list {
    display: grid;
    gap: 10px;
    grid-template-columns: 1fr;
}

.graduate-list .graduate-card {
    align-items: center;
    border-left: 4px solid var(--ink);
    border-top: 1px solid var(--line);
    display: grid;
    gap: 18px;
    grid-template-columns:
        52px minmax(150px, 1.1fr) minmax(240px, 1.6fr)
        minmax(170px, 1fr);
    min-height: 0;
    padding: 15px 18px;
}

.graduate-list .graduate-card-top {
    display: contents;
}

.graduate-list .graduate-avatar {
    grid-column: 1;
    grid-row: 1 / span 2;
}

.graduate-list .graduate-card h3 {
    grid-column: 2;
    grid-row: 1;
    margin: 0;
}

.graduate-list .graduate-reference {
    grid-column: 2;
    grid-row: 2;
}

.graduate-list .edition-status {
    grid-column: 4;
    grid-row: 1;
    justify-self: end;
}

.graduate-list .graduate-details {
    border-bottom: 0;
    border-top: 0;
    grid-column: 3;
    grid-row: 1 / span 2;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
}

.graduate-list .graduate-details div {
    display: grid;
    gap: 4px;
}

.graduate-list .graduate-details dd {
    max-width: none;
    text-align: left;
}

.graduate-list .graduate-footer {
    grid-column: 4;
    grid-row: 2;
    justify-content: flex-end;
}

.graduate-list .graduate-actions {
    grid-column: 1 / -1;
    grid-row: 3;
    margin-top: 2px;
    padding-top: 10px;
}

@media (max-width: 900px) {
    .graduate-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .graduate-list .graduate-card {
        grid-template-columns: 52px minmax(150px, 1fr) minmax(180px, 1fr);
    }

    .graduate-list .graduate-details {
        grid-column: 3;
    }

    .graduate-list .edition-status,
    .graduate-list .graduate-footer {
        grid-column: 2 / -1;
    }
}

@media (max-width: 600px) {
    .graduate-toolbar-tools {
        align-items: stretch;
        flex-direction: column;
    }

    .view-switcher {
        align-self: flex-end;
    }

    .graduate-list .graduate-card {
        align-items: start;
        grid-template-columns: 52px 1fr;
    }

    .graduate-list .graduate-details,
    .graduate-list .edition-status,
    .graduate-list .graduate-footer {
        grid-column: 1 / -1;
        grid-row: auto;
    }

    .graduate-list .graduate-details {
        grid-template-columns: 1fr;
        margin-top: 8px;
    }

    .graduate-list .graduate-actions {
        grid-column: 1 / -1;
    }

    .graduate-intro {
        min-height: 290px;
        padding: 32px 24px;
        align-items: end;
    }

    .graduate-intro-stats {
        position: absolute;
        right: 24px;
        top: 28px;
    }

    .graduate-toolbar {
        align-items: stretch;
        flex-direction: column;
    }

    .graduate-grid {
        grid-template-columns: 1fr;
    }
}

.graduate-form-wrap,
.graduation-form-wrap,
.media-wrap {
    padding-top: 8px;
}

.graduate-form,
.graduation-form {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(280px, 0.7fr);
    gap: 24px;
    align-items: start;
}

.form-main,
.form-aside {
    display: grid;
    gap: 24px;
}

.form-section,
.portrait-upload {
    background: var(--white);
    border: 1px solid var(--line);
    padding: 28px;
}

.form-section-heading {
    border-bottom: 1px solid var(--line);
    margin-bottom: 22px;
    padding-bottom: 15px;
}

.form-section-heading h2,
.portrait-upload h2 {
    color: var(--ink);
    font-size: 21px;
    margin: 0;
}

.form-grid {
    display: grid;
    gap: 18px;
}

.form-grid-two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.form-field {
    display: grid;
    gap: 7px;
    color: var(--ink);
    font-size: 11px;
    font-weight: 700;
}

.form-field-wide {
    grid-column: 1 / -1;
}

.form-field input,
.form-field select,
.form-field textarea {
    background: #f7fbff;
    border: 1px solid var(--line);
    border-radius: 0;
    color: #2d3748;
    font:
        13px "Inter",
        sans-serif;
    padding: 11px 12px;
    width: 100%;
}

.form-field textarea {
    resize: vertical;
}

.form-field small,
.form-error {
    color: #c0522a;
    font-size: 10px;
    font-weight: 400;
}

.selection-block {
    border-top: 1px solid var(--line);
    padding: 20px 0 2px;
}

.selection-block + .selection-block {
    margin-top: 18px;
}

.selection-heading {
    display: grid;
    gap: 5px;
    margin-bottom: 13px;
}

.select-all {
    align-items: center;
    color: var(--ink-soft);
    display: flex;
    font-size: 10px;
    font-weight: 600;
    gap: 7px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.select-all input {
    accent-color: var(--red);
}

.form-field-label {
    color: var(--ink);
    font-size: 11px;
    font-weight: 700;
}

.selection-heading small {
    color: var(--ink-soft);
    font-size: 11px;
    font-weight: 400;
}

.choice-grid {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.choice-item {
    align-items: center;
    background: #f7fbff;
    border: 1px solid var(--line);
    color: var(--ink);
    cursor: pointer;
    display: flex;
    gap: 10px;
    min-height: 44px;
    padding: 9px 12px;
    transition:
        border-color 0.2s ease,
        background 0.2s ease;
}

.choice-item:has(input:checked) {
    background: #fff3d7;
    border-color: #ffce6b;
}

.choice-item input {
    accent-color: var(--red);
    flex: 0 0 auto;
}

.choice-item span {
    font-size: 12px;
    line-height: 1.35;
}

.graduation-note p:not(.eyebrow) {
    color: #8b3a0d;
    font-size: 13px;
    line-height: 1.6;
    margin: 0;
}

.portrait-upload {
    background: #fff3d7;
    border-color: #ffce6b;
}

.portrait-upload h2 {
    margin-bottom: 18px;
}

.portrait-preview,
.portrait-placeholder {
    background: #e7f0fa;
    height: 220px;
    object-fit: cover;
    width: 100%;
}

.portrait-placeholder {
    color: var(--ink);
    display: grid;
    place-items: center;
    font:
        700 48px "Merriweather",
        serif;
}

.upload-field {
    border: 1px dashed #c0522a;
    color: #8b3a0d;
    cursor: pointer;
    display: grid;
    gap: 7px;
    margin-top: 16px;
    padding: 15px;
}

.upload-field span {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}

.upload-field input {
    font:
        11px "Inter",
        sans-serif;
    max-width: 100%;
}

.upload-field small,
.upload-note {
    color: #8b3a0d;
    font-size: 11px;
    line-height: 1.45;
}

.upload-note {
    margin: 16px 0 0;
}

.form-section-compact {
    padding: 22px;
}

.form-section-compact .form-section-heading {
    margin-bottom: 17px;
}

.form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
}

.button-muted {
    background: var(--white);
    border: 1px solid var(--line);
    color: var(--ink-soft);
}

.media-heading {
    padding-bottom: 34px;
}

.media-wrap {
    padding-top: 0;
}

.media-toolbar {
    align-items: center;
    background: var(--white);
    border: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 26px;
}

.media-toolbar h2 {
    color: var(--ink);
    font-size: 21px;
    margin: 0;
}

.media-filters {
    display: flex;
    gap: 5px;
}

.media-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 24px;
}

.media-card {
    background: var(--white);
    border: 1px solid var(--line);
    min-width: 0;
}

.media-preview {
    background: #e7f0fa;
    height: 230px;
    display: grid;
    place-items: center;
    overflow: hidden;
}

.media-preview img {
    height: 100%;
    object-fit: cover;
    width: 100%;
}

.media-card-body {
    padding: 18px;
}

.media-file-name {
    color: var(--ink-soft);
    font-size: 10px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.media-caption {
    color: var(--ink);
    font-size: 13px;
    font-weight: 700;
}

.media-meta {
    color: var(--ink-soft);
    font-size: 11px;
}

.media-actions {
    display: flex;
    gap: 8px;
    margin-top: 16px;
}

.media-actions .button,
.media-actions .action-button {
    flex: 1;
    justify-content: center;
}

.portrait-links {
    border-top: 1px solid var(--line);
    display: grid;
    gap: 6px;
    margin-top: 14px;
    padding-top: 13px;
}

.portrait-links span {
    color: #c0522a;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.portrait-links a {
    color: var(--ink);
    font-size: 12px;
    font-weight: 600;
}

.portrait-links a:hover {
    color: #0a66c2;
}

@media (max-width: 850px) {
    .graduate-form,
    .graduation-form {
        grid-template-columns: 1fr;
    }

    .form-aside {
        grid-row: 1;
    }

    .media-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 600px) {
    .form-grid-two,
    .media-grid {
        grid-template-columns: 1fr;
    }

    .media-toolbar {
        align-items: stretch;
        flex-direction: column;
    }

    .media-filters {
        flex-wrap: wrap;
    }

    .form-section,
    .portrait-upload {
        padding: 20px;
    }

    .form-actions {
        justify-content: stretch;
    }

    .form-actions .button {
        flex: 1;
        justify-content: center;
    }
}

@media (max-width: 600px) {
    .graduation-intro {
        padding: 32px 24px;
        min-height: 290px;
        align-items: end;
    }

    .edition-count {
        position: absolute;
        right: 24px;
        top: 28px;
    }

    .graduation-toolbar {
        align-items: stretch;
        flex-direction: column;
    }

    .search-field input {
        width: 100%;
    }

    .featured-edition {
        display: block;
        padding: 22px;
    }

    .featured-date {
        border-right: 0;
        border-bottom: 1px solid rgba(192, 82, 42, 0.3);
        margin-bottom: 20px;
        padding: 0 0 15px;
    }

    .featured-edition > .button {
        margin-top: 20px;
    }

    .edition-grid {
        grid-template-columns: 1fr;
    }
}

.mobile-toggle {
    margin-left: auto;
}

@media (max-width: 800px) {
    .nav-inner,
    .dashboard-heading,
    .dashboard-wrap {
        padding-left: 20px;
        padding-right: 20px;
    }

    .dashboard-heading {
        align-items: start;
        flex-direction: column;
        gap: 20px;
    }

    .welcome-banner {
        padding: 30px 24px;
    }

    .banner-mark {
        font-size: 40px;
    }

    .stat-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .stat-card {
        border-bottom: 0;
    }

    .content-grid {
        grid-template-columns: 1fr;
    }

    .panel-wide {
        grid-column: auto;
    }
}

@media (max-width: 480px) {
    .stat-grid {
        grid-template-columns: 1fr;
        border-left: 0;
    }

    .stat-card {
        border-left: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
    }

    .welcome-banner {
        min-height: 230px;
        align-items: end;
    }

    .banner-mark {
        position: absolute;
        right: 24px;
        top: 26px;
    }

    .school-grid {
        grid-template-columns: 1fr;
    }

    .panel {
        padding: 22px 18px;
    }

    .workflow-row {
        grid-template-columns: 86px 1fr 24px;
        gap: 9px;
        font-size: 11px;
    }
}

:root {
    --content-max: 1280px;
    --space-page: clamp(20px, 4vw, 48px);
}

.site-shell {
    min-height: 100vh;
    background: var(--paper);
}

.page-header {
    background: var(--white);
    border-bottom: 1px solid var(--line);
}

.page-header-inner,
.page-content {
    width: min(100%, var(--content-max));
    margin-inline: auto;
}

.page-header-inner {
    padding-inline: var(--space-page);
}

.page-content {
    min-width: 0;
}

h1,
h2 {
    color: var(--ink);
}

.welcome-banner h2,
.graduation-intro h2,
.graduate-intro h2,
.panel-dark h2 {
    color: var(--white);
}

.dashboard-heading,
.dashboard-wrap {
    max-width: var(--content-max);
    padding-inline: var(--space-page);
}

.nav-inner {
    width: 100%;
    max-width: var(--content-max);
    padding-inline: var(--space-page);
}

@media (max-width: 800px) {
    .nav-inner,
    .dashboard-heading,
    .dashboard-wrap {
        padding-inline: var(--space-page);
    }
}

.login-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: var(--space-page);
    background: var(--paper);
}

.login-panel {
    width: min(100%, 460px);
    background: var(--white);
    border: 1px solid var(--line);
    padding: 36px;
}

.login-header {
    margin-bottom: 28px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--line);
}

.login-header h1 {
    margin: 0;
    color: var(--ink);
    font-family: "Merriweather", Georgia, serif;
    font-size: 32px;
    font-weight: 700;
}

.login-description {
    margin: 10px 0 0;
    color: var(--ink-soft);
    font-size: 12px;
    line-height: 1.6;
}

.login-form {
    display: grid;
    gap: 18px;
}

.login-options {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
}

.remember-option {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink-soft);
    cursor: pointer;
    font-size: 11px;
    font-weight: 600;
}

.remember-option input {
    width: 15px;
    height: 15px;
    margin: 0;
    accent-color: var(--ink);
}

.login-forgot {
    color: var(--ink-soft);
    font-size: 11px;
    font-weight: 600;
    text-decoration: none;
}

.login-forgot:hover {
    color: var(--ink);
    text-decoration: underline;
}

.login-button {
    width: 100%;
    margin-top: 4px;
}

@media (max-width: 480px) {
    .login-page {
        padding: 20px;
    }

    .login-panel {
        padding: 26px 22px;
    }

    .login-options {
        align-items: flex-start;
        flex-direction: column;
    }
}

/* ========================================
   PUBLIC PAGE STYLES
   (elegant pass — scoped to .public-shell so
   nothing here touches admin/dashboard/login/
   graduate/event/ai/media styles above)
   ======================================== */

.public-shell {
    display: flex;
    flex-direction: column;
    min-height: 100vh;

    /* Scoped tokens — a quieter, printed-program palette.
       Distinct variable names on purpose: the admin UI above
       keeps using --ink/--red/--gold untouched. */
    --pub-ink: #0a1f3d;
    --pub-ink-soft: #6b6459;
    --pub-paper: #f8f5ee;
    --pub-white: #fffdf8;
    --pub-line: #e4ddd0;
    --pub-gold: #b8860b;
    --pub-gold-light: #d4af6a;
    --pub-oxblood: #7a1f2b;
    --pub-ease: cubic-bezier(0.19, 1, 0.22, 1);

    background: var(--pub-paper);
    color: #2d2a24;
}

.public-nav-links {
    display: flex;
    gap: 28px;
    align-items: center;
}

.public-staff-link {
    color: var(--pub-ink-soft);
    font-size: 11px;
    font-weight: 500;
    font-style: italic;
    font-family: "Merriweather", serif;
    padding: 8px 0;
}

.public-staff-link:hover {
    color: var(--pub-ink);
}

/* ===== HERO SECTION ===== */
.public-hero {
    background: var(--pub-ink);
    color: var(--pub-white);
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 340px;
    padding: 56px 48px;
    position: relative;
    overflow: hidden;
    margin: 0 -32px;
}

.public-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 140px rgba(10, 31, 61, 0.55);
    pointer-events: none;
}

.public-hero-inner {
    max-width: 560px;
    z-index: 1;
}

.public-hero h1 {
    color: var(--pub-white);
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1.18;
    font-weight: 400;
    letter-spacing: -0.01em;
    margin: 10px 0 16px;
}

.public-hero-inner p:not(.eyebrow) {
    color: #d8ccb0;
    font-family: "Merriweather", Georgia, serif;
    font-style: italic;
    font-size: 15px;
    margin: 0 0 26px;
    line-height: 1.6;
}

.public-hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
}

/* ===== BUTTONS (public) ===== */
.button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 26px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.03em;
    border: none;
    cursor: pointer;
    transition: background 0.35s var(--pub-ease);
    text-decoration: none;
}

.public-shell .button-red {
    background: var(--pub-ink);
    color: var(--pub-white);
}

.public-shell .button-red:hover {
    background: var(--pub-oxblood);
    transform: none;
}

.button-outline-public {
    border: 1px solid rgba(255, 253, 248, 0.4);
    color: var(--pub-white);
    background: transparent;
}

.button-outline-public:hover {
    background: rgba(255, 253, 248, 0.08);
    border-color: var(--pub-gold-light);
}

/* ===== HERO STATS ===== */
.public-hero-stats {
    display: flex;
    gap: 48px;
    color: var(--pub-gold-light);
    z-index: 1;
}

.public-hero-stats div {
    text-align: center;
}

.public-hero-stats strong {
    display: block;
    font:
        400 44px/1 "Merriweather",
        serif;
}

.public-hero-stats span {
    color: #b9ac8c;
    font-size: 10px;
    font-weight: 500;
    font-style: italic;
    letter-spacing: 0.02em;
}

/* ===== SECTION HEADINGS ===== */
.public-section {
    max-width: 1280px;
    margin: 0 auto;
    padding: 48px 0 0;
}

.public-shell .eyebrow {
    color: var(--pub-gold);
    font-size: 13px;
    font-weight: 500;
    font-style: italic;
    font-family: "Merriweather", Georgia, serif;
    letter-spacing: 0;
    text-transform: none;
    margin: 0 0 9px;
}

.public-shell .eyebrow-light {
    color: var(--pub-gold-light);
}

.public-shell .section-heading {
    border-bottom: 1px solid var(--pub-line);
}

.public-shell .section-heading h2 {
    color: var(--pub-ink);
    font-size: 26px;
    font-weight: 400;
    margin: 0;
    font-family: "Merriweather", Georgia, serif;
}

.public-shell .text-link {
    color: var(--pub-oxblood);
    font-size: 12px;
    font-weight: 500;
    font-style: italic;
    font-family: "Merriweather", Georgia, serif;
    text-decoration: none;
    position: relative;
}

.public-shell .text-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--pub-ease);
}

.public-shell .text-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
}

/* ===== EVENT GRID ===== */
.public-event-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--pub-line);
    margin-top: 20px;
    border: 1px solid var(--pub-line);
}

.public-event-card {
    background: var(--pub-white);
    border: none;
    padding: 26px;
    display: block;
    text-decoration: none;
    transition: background 0.35s var(--pub-ease);
}

.public-event-card:hover {
    background: #fbf8f1;
    box-shadow: none;
    transform: none;
}

.public-event-date {
    color: var(--pub-gold);
    font-size: 11px;
    font-weight: 500;
    font-style: italic;
    font-family: "Merriweather", Georgia, serif;
    letter-spacing: 0;
}

.public-event-card h3 {
    color: var(--pub-ink);
    font:
        700 18px/1.35 "Merriweather",
